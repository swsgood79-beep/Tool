package main
import("encoding/json";"net/http/httptest";"os";"os/exec";"testing")
func TestOrderSearchPreview(t *testing.T){
 if os.Getenv("ORDER_SEARCH_PREVIEW")!="1"{t.Skip("optional temporary browser server")}
 a:=fixture(t);owner:=adminCookie(a);a.state.Integration.MobileEnabled=true
 a.state.Projects[0].Name="케이투레이저 6축 (예가)"
 srv:=httptest.NewServer(a);defer srv.Close()
 cfg,_:=json.Marshal(map[string]any{"cookie":map[string]string{"name":owner.Name,"value":owner.Value},"board":a.state.Board})
 cmd:=exec.Command("node","audit/browser-order-search-v1.4.102.cjs",srv.URL,string(cfg));cmd.Stdout=os.Stdout;cmd.Stderr=os.Stderr
 if e:=cmd.Run();e!=nil{t.Fatal(e)}
}
